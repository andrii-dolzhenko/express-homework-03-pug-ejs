<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Articles | Express Homework 03</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="/users">Users</a>
        <a href="/articles" aria-current="page">Articles</a>
      </nav>
    </header>
    <main>
      <h1>Articles</h1>
      <p>Explore articles rendered on the server using EJS.</p>
      <% if (articles.length) { %>
        <ul>
          <% articles.forEach((article) => { %>
            <li>
              <a href="/articles/<%= encodeURIComponent(article.id) %>"><%= article.title %></a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No articles found.</p>
      <% } %>
    </main>
    <footer>
      <p>Copyright © 2026 Andrii Dolzhenko.</p>
    </footer>
  </body>
</html>
