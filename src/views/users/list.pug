doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Users | Express Homework 03
  body
    header
      nav(aria-label="Main navigation")
        a(href="/users" aria-current="page") Users
        a(href="/articles") Articles
    main
      h1 Users
      p Explore users rendered on the server using PUG.
      if users.length
        ul
          each user in users
            li
              a(href='/users/' + encodeURIComponent(user.id))= user.name
      else
        p No users found.
    footer
      p Copyright © 2026 Andrii Dolzhenko.
